# 构建产物强制 LF（2026-08-19 审计修复：Windows CRLF 产物导致 dist MD5 跨平台不可比，
# bazi-app MD5 对齐机制失效；LF 后本地/CI/bazi-app 三方字节一致）
ui/index.html text eol=lf
engine/engine.dist.js text eol=lf
kb/04-rules-db/rules.json text eol=lf
skill/SKILL.md text eol=lf
tools/*.js text eol=lf
tools/*.py text eol=lf
*.md text eol=lf
# 2026-10 兜底：原清单漏了 ui/jieqi.json、tools/archive/*（tools/*.js 不递归）、.github/workflows/ci.yml、
# tools/publish_clawhub.ps1、LICENSE/LICENSE-DATA 等；靠 core.autocrlf 兜底不可移植（换一台 autocrlf=false 的机器即失稳）
* text=auto eol=lf
